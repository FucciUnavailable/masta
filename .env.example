# Copy to `.env` and fill in the providers you want to use.
# masta is provider-agnostic: configure ONE or MANY. You can switch between
# them at runtime via model profiles (see `masta providers` and config.toml).

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Azure OpenAI / AI Foundry ---
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-06-01

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# --- Local models via Ollama (no key needed; just run `ollama serve`) ---
# Default base url is http://localhost:11434
OLLAMA_API_BASE=http://localhost:11434

# --- masta settings (optional overrides) ---
# MASTA_DEFAULT_PROFILE=claude
# MASTA_DATA_DIR=~/.local/share/masta
